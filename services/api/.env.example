APP_ENV=development
CORS_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://user:password@host.neon.tech/db?sslmode=require
NEON_AUTH_URL=https://your-neon-auth-url
NEON_AUTH_AUDIENCE=schoolic
AI_FEATURES_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=your-model
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=18000
AI_REQUESTS_PER_USER=20
AI_REQUEST_WINDOW_MINUTES=60
# Configure AI_API_KEY as a server-side secret only.
