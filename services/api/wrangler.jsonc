{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolic-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "CORS_ORIGIN": "http://localhost:8080,http://127.0.0.1:8080",
    "NEON_AUTH_URL": "http://localhost:8787"
  },
  "env": {
    "staging": {
      "name": "schoolic-api-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "CORS_ORIGIN": "https://schoolic-staging.pages.dev",
        "NEON_AUTH_URL": "https://ep-billowing-shadow-b56k9cl2.neonauth.c-7.us-east-2.aws.neon.tech/neondb",
        "AI_FEATURES_ENABLED": "true",
        "AI_PROVIDER": "openai-compatible",
        "AI_MODEL": "qwen/qwen3.8-27b",
        "AI_BASE_URL": "https://api.groq.com/openai/v1",
        "AI_MAX_OUTPUT_TOKENS": "1200",
        "AI_TIMEOUT_MS": "30000",
        "AI_REQUESTS_PER_USER": "20",
        "AI_REQUEST_WINDOW_MINUTES": "60"
      }
    },
    "production": {
      "name": "schoolic-api",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGIN": "https://schoolic.pages.dev",
        "NEON_AUTH_URL": "https://ep-polished-silence-b52ozwm7.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
      }
    }
  }
}
