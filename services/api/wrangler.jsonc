{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolic-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "CORS_ORIGIN": "http://localhost:8080,http://127.0.0.1:8080",
    "NEON_AUTH_URL": "http://localhost:8787"
  },
  "env": {
    "staging": {
      "name": "schoolic-api-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "CORS_ORIGIN": "https://schoolic-staging.pages.dev",
        "NEON_AUTH_URL": "https://ep-billowing-shadow-b56k9cl2.neonauth.c-7.us-east-2.aws.neon.tech/neondb"
      }
    },
    "production": {
      "name": "schoolic-api",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGIN": "https://schoolic.pages.dev",
        "NEON_AUTH_URL": "https://ep-polished-silence-b52ozwm7.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
      }
    }
  }
}
