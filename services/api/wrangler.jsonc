{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolic-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api-school.zephvion.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "CORS_ORIGIN": "http://localhost:8080",
    "NEON_AUTH_URL": "https://replace-with-neon-auth-url"
  }
}
